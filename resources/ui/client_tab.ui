  <property name="styleSheet">
   <string notr="true">/* Fondo general */
QMainWindow {
    background-color: #f9f9f9;
    font-family: &quot;Poppins&quot;, &quot;Segoe UI&quot;, sans-serif;
    font-size: 14px;
}

/* Botón &quot;Nuevo cliente&quot; */
QPushButton {
    background-color: #007BFF;
    color: white;
    border-radius: 8px;
    padding: 6px 16px;
    font-weight: bold;
}
QPushButton:hover {
    background-color: #0056b3;
}

/* QLineEdit (buscador) */
QLineEdit {
    border: 2px solid #ddd;
    border-radius: 8px;
    padding: 6px 12px;
    background-color: white;
}
QLineEdit:focus {
    border-color: #007BFF;
}

/* QTableWidget / QTableView */
QHeaderView::section {
    background-color: #ececec;
    color: #333;
    padding: 4px;
    border: none;
    font-weight: bold;
}
QTableWidget {
    border: 1px solid #ddd;
    background-color: white;
    gridline-color: #ccc;
    alternate-background-color: #f2f2f2;
}
QTableWidget::item {
    padding: 6px;
}
QTableWidget::item:hover {
    background-color: #f0f8ff;
}

/* QTabWidget (barra de navegación) */
QTabBar::tab {
    background: #2C3E50;
    color: white;
    padding: 10px 20px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}
QTabBar::tab:selected {
    background: #34495E;
    font-weight: bold;
    border-bottom: 2px solid #007BFF;
}
QTabBar::tab:hover {
    background: #3E556E;
}

/* Paginación (si usás QLabel/QPushButton para ello) */
QLabel#paginaActual {
    color: #007BFF;
    font-weight: bold;
}
QPushButton#btnAnterior, QPushButton#btnSiguiente {
    background-color: transparent;
    border: none;
    color: #007BFF;
    font-size: 16px;
}
QPushButton#btnAnterior:hover, QPushButton#btnSiguiente:hover {
    color: #0056b3;
    font-weight: bold;
}
</string>
