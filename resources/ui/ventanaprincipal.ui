          <string notr="true">

/* Estilo de las pestañas (QTabBar dentro del QTabWidget) */
QTabBar::tab {
    background-color: rgb(218, 218, 218);  /* Color de pestañas normales */
    border: 1px solid #595959;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    padding: 2px;
}

/* Efecto hover: Cambia el color cuando el mouse pasa sobre la pestaña */
QTabBar::tab:hover {
    background-color: rgb(255, 255, 255);  /* Cambia el color al pasar el mouse */
 
}

/* Efecto para la pestaña seleccionada */
QTabBar::tab:selected {
    background-color: rgb(170, 255, 255);  /* Color de la pestaña activa */
	color: black;
    font-weight: bold;
}</string>
