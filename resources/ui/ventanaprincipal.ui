   <string notr="true">/* Fondo gris para la barra de navegación */
QTabBar {
    background: #D3D3D3; /* Gris claro */
}
/* QTabWidget (barra de navegación) */
QTabBar::tab {
    background: #2C3E50;
    color: white;
    padding: 7px 18px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;	
	border: 1px solid rgb(255, 255, 255);

}
QTabBar::tab:selected {
    background: #34495E;
    font-weight: bold;
    border-bottom: 5px solid #007BFF;
}

QTabBar::tab:hover {
    background: #3E556E;

}

background-color: rgb(191, 191, 191);

