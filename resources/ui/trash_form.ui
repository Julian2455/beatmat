}

QTableWidget::item:selected {
    background-color: #3498db;
    color: white;
}

QHeaderView::section {
    background-color: #e0e0e0;
    color: #333333;
    padding: 5px;
    border: 1px solid #cccccc;
    font-weight: bold;
}

QPushButton {
    background-color: #3498db;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 5px 10px;
    min-height: 30px;
}

QPushButton:hover {
    background-color: #2980b9;
}

QPushButton:disabled {
    background-color: #bdc3c7;
}

QCheckBox {
    spacing: 5px;
    color: #333333;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
}

QCheckBox::indicator:unchecked {
    border: 1px solid #cccccc;
    background-color: white;
}

QCheckBox::indicator:checked {
    border: 1px solid #3498db;
    background-color: #3498db;
}

QCheckBox::indicator:unchecked:hover {
    border: 1px solid #3498db;
}

QCheckBox::indicator:checked:hover {
    background-color: #2980b9;
    border: 1px solid #2980b9;
}

QFrame#frameClientes, QFrame#frameExtintores {
    border: 1px solid #cccccc;
    border-radius: 5px;
    background-color: white;
}

QLabel#labelTituloClientes, QLabel#labelTituloExtintores {
    background-color: #e0e0e0;
    color: #333333;
    padding: 10px;
    border-radius: 3px;
    font-weight: bold;
}


QLineEdit {
    background-color: white;
    color: black;
    border: 2px solid #cccccc;
    border-radius: 10px;
    padding: 2px;
